{
  "name": "substack-dashboard",
  "version": "1.0.0",
  "description": "Local analytics dashboard for your own Substack publications, built on Substack's private API using your browser session.",
  "scripts": {
    "login": "NODE_NO_WARNINGS=1 node tools/login.mjs",
    "sync": "NODE_NO_WARNINGS=1 node tools/sync.mjs",
    "build": "NODE_NO_WARNINGS=1 node tools/build.mjs",
    "refresh": "npm run sync && npm run build",
    "serve": "NODE_NO_WARNINGS=1 node tools/server.mjs 8787",
    "import": "NODE_NO_WARNINGS=1 node tools/import.mjs",
    "start": "NODE_NO_WARNINGS=1 node tools/server.mjs 8787",
    "install-service": "node tools/install-service.mjs",
    "uninstall-service": "node tools/install-service.mjs --uninstall",
    "demo": "python3 tools/make_demo.py demo",
    "skill-template": "python3 tools/make_skill_template.py"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "playwright-core": "^1.62.1"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Pol Marzà"
}
