{
  "manifest_version": 3,
  "name": "Substack Dashboard",
  "version": "1.5.0",
  "description": "Your own analytics dashboard for the Substack publications you write: views, opens, reactions, growth and subscribers by country.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Substack Dashboard",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.substack.com/*",
    "https://substack.com/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
